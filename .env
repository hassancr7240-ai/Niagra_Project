# ─── Application ────────────────────────────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=change-me-in-production-use-a-32-char-random-string
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false

# ─── Azure AD Authentication ─────────────────────────────────────────────────
# Leave blank to use dev mode (API key auth only)
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_AUTHORITY=https://login.microsoftonline.com/

# ─── Database ────────────────────────────────────────────────────────────────
# Local SQLite (dev default — leave DATABASE_URL blank to use SQLite)
DATABASE_URL=
# Azure SQL (production)
# DATABASE_URL=mssql+pyodbc:///?odbc_connect=Driver={ODBC Driver 18 for SQL Server};Server=tcp:<server>.database.windows.net,1433;Database=<db>;Authentication=ActiveDirectoryMsi;

# ─── Azure Blob Storage ───────────────────────────────────────────────────────
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_CONTAINER_NAME=pm-docs
AZURE_STORAGE_CONNECTION_STRING=
# SAS token expiry for download links (hours)
DOWNLOAD_LINK_EXPIRY_HOURS=8

# ─── Azure Key Vault ─────────────────────────────────────────────────────────
AZURE_KEY_VAULT_URL=
# Leave blank in dev — secrets loaded from this .env file instead

# ─── FTP / SFTP Server ───────────────────────────────────────────────────────
FTP_HOST=
FTP_PORT=22
FTP_USERNAME=
FTP_KEY_PATH=
FTP_REMOTE_BASE_PATH=/pm-docs

# ─── AI / Local IBM Granite via Ollama ───────────────────────────────────────
# watsonx account is blocked (BXNIM0434E), so we run the same Granite model
# family locally through Ollama's OpenAI-compatible server. No cloud account,
# no API key, no rate limits — everything stays on this machine.
AI_PROVIDER=openai
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama
OPENAI_MODEL_GENERATION=granite3.3:2b
OPENAI_MODEL_CLASSIFICATION=granite3.3:2b
OPENAI_EMBEDDING_MODEL=granite-embedding:latest
OPENAI_EMBEDDING_DIMS=384

# IBM watsonx.ai — kept here in case the account gets unblocked later.
# To switch back: set AI_PROVIDER=watsonx (keys below already filled in).
# AI_PROVIDER=watsonx
WATSONX_API_KEY=KUHESc0VOQLQnUmsTlao_-EwqGcbbVJaNZ047fVdb7IG
WATSONX_PROJECT_ID=3a754d78-8368-4d9a-a5a3-902a85e0d81d
WATSONX_URL=https://us-south.ml.cloud.ibm.com
# Models (all IBM Granite):
# ibm/granite-13b-instruct-v2  → classify + analytics + chat
# ibm/slate-125m-english-rtrvr → embeddings (1024 dims)
# ibm/granite-3b-code-instruct → task extraction from manual chunks

# ─── Azure AI Search (Vector Store) ─────────────────────────────────────────
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX_NAME=pm-manuals

# ─── Storage Target Default ──────────────────────────────────────────────────
# Options: azure, ftp, local
DEFAULT_STORAGE_TARGET=local
LOCAL_STORAGE_PATH=./output/pm-docs

# ─── Rate Limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=100

# ─── App Insights ────────────────────────────────────────────────────────────
APPLICATIONINSIGHTS_CONNECTION_STRING=

# ─── Dev API Key (used when AZURE_AD_TENANT_ID is blank) ────────────────────
DEV_API_KEY=dev-secret-key-change-in-prod
