# ─── Application ────────────────────────────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=change-me-in-production-use-a-32-char-random-string
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false

# ─── Azure AD Authentication ─────────────────────────────────────────────────
# Leave blank to use dev mode (API key auth only)
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_AUTHORITY=https://login.microsoftonline.com/

# ─── Database ────────────────────────────────────────────────────────────────
# Local SQLite (dev default — leave DATABASE_URL blank to use SQLite)
DATABASE_URL=
# Azure SQL (production)
# DATABASE_URL=mssql+pyodbc:///?odbc_connect=Driver={ODBC Driver 18 for SQL Server};Server=tcp:<server>.database.windows.net,1433;Database=<db>;Authentication=ActiveDirectoryMsi;

# ─── Azure Blob Storage ───────────────────────────────────────────────────────
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_CONTAINER_NAME=pm-docs
AZURE_STORAGE_CONNECTION_STRING=
# SAS token expiry for download links (hours)
DOWNLOAD_LINK_EXPIRY_HOURS=8

# ─── Azure Key Vault ─────────────────────────────────────────────────────────
AZURE_KEY_VAULT_URL=
# Leave blank in dev — secrets loaded from this .env file instead

# ─── FTP / SFTP Server ───────────────────────────────────────────────────────
FTP_HOST=
FTP_PORT=22
FTP_USERNAME=
FTP_KEY_PATH=
FTP_REMOTE_BASE_PATH=/pm-docs

# ─── AI / OpenAI ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL_GENERATION=gpt-4o
OPENAI_MODEL_CLASSIFICATION=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_DIMS=3072

# IBM watsonx.ai — Data Flow Diagram models (set AI_PROVIDER=watsonx to use these)
# Classification:  ibm/granite-13b-instruct-v2  → Detects machine/manufacturer, analyses PM patterns
# Embedding:       ibm/slate-125m-english-rtrvr → 1024 dims → Azure AI Search
# Generation:      ibm/granite-3b-code-instruct → Extracts structured JSON tasks from manual chunks
# Analytics:       ibm/granite-13b-instruct-v2  → Predicts next PM due, analyses overdue patterns
AI_PROVIDER=openai
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# ─── Azure AI Search (Vector Store) ─────────────────────────────────────────
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX_NAME=pm-manuals

# ─── Storage Target Default ──────────────────────────────────────────────────
# Options: azure, ftp, local
DEFAULT_STORAGE_TARGET=local
LOCAL_STORAGE_PATH=./output/pm-docs

# ─── Rate Limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=100

# ─── App Insights ────────────────────────────────────────────────────────────
APPLICATIONINSIGHTS_CONNECTION_STRING=

# ─── Dev API Key (used when AZURE_AD_TENANT_ID is blank) ────────────────────
DEV_API_KEY=dev-secret-key-change-in-prod
