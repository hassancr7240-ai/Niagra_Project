# ─── Application ─────────────────────────────────────────────────────────────
# APP_ENV: development | production
APP_ENV=production
# Generate a strong 32+ char secret: python -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET_KEY=change-me-in-production-use-a-32-char-random-string
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false

# ─── CORS (Production) ───────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Leave blank to use default Azure URL.
# Example: https://pm-automation.azurewebsites.net,https://pm.yourcompany.com
ALLOWED_ORIGINS=

# ─── Azure AD Authentication ─────────────────────────────────────────────────
# Leave ALL blank to run in dev mode (API key only — no real SSO)
# Get these from: Azure Portal → App Registrations → your app
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_AUTHORITY=https://login.microsoftonline.com/

# ─── Database ────────────────────────────────────────────────────────────────
# Leave blank → uses SQLite at data/pm_automation.db (dev)
# Production: use Azure SQL with Managed Identity
DATABASE_URL=mssql+aioodbc:///?odbc_connect=Driver={ODBC Driver 18 for SQL Server};Server=tcp:niagara-pmdb.database.windows.net,1433;Database=pmw_production;Authentication=ActiveDirectoryMsi;Encrypt=yes;

# ─── Azure Blob Storage ───────────────────────────────────────────────────────
AZURE_STORAGE_ACCOUNT_NAME=niagarapmstorage
AZURE_STORAGE_CONTAINER_NAME=pm-manuals
# Production: use Managed Identity (leave connection string blank)
AZURE_STORAGE_CONNECTION_STRING=
# Time-limited SAS URL expiry for download links (hours)
DOWNLOAD_LINK_EXPIRY_HOURS=8

# ─── Azure Key Vault ─────────────────────────────────────────────────────────
# Example: https://niagara-keyvault.vault.azure.net/
# Production: pull secrets from Key Vault
AZURE_KEY_VAULT_URL=

# ─── FTP / SFTP (internal factory file share) ─────────────────────────────────
FTP_HOST=
FTP_PORT=22
FTP_USERNAME=
FTP_KEY_PATH=
FTP_REMOTE_BASE_PATH=/pm-docs

# ─── AI Provider ─────────────────────────────────────────────────────────────
# PRODUCTION ONLY: Use IBM watsonx.ai for enterprise AI capabilities
AI_PROVIDER=watsonx

# ─── IBM watsonx.ai (PRODUCTION AI PIPELINE) ────────────────────────────────
# Get API key and Project ID from: cloud.ibm.com → Manage → Access (IAM) → API keys
#
# Model Stack (matches production deployment):
#   Generation:       meta-llama/llama-3-3-70b-instruct → extract 100+ PM tasks per PDF
#   Embedding:        ibm/slate-125m-english-rtrvr     → chunk relevance scoring (512 token max)
#   Classification:   Auto-detected from task content   → manufacturer identification
#
WATSONX_API_KEY=your-ibm-api-key-here
WATSONX_PROJECT_ID=your-ibm-project-id-here
WATSONX_URL=https://us-south.ml.cloud.ibm.com
# Model overrides (optional — defaults match production):
# WATSONX_MODEL_GENERATION=meta-llama/llama-3-3-70b-instruct
# WATSONX_EMBEDDING_MODEL=ibm/slate-125m-english-rtrvr
# WATSONX_EMBEDDING_DIMS=1536

# ─── Storage Target ───────────────────────────────────────────────────────────
# Options: local | azure | ftp
# Production: azure (all PDFs and ZIPs stored in Blob Storage)
DEFAULT_STORAGE_TARGET=azure
LOCAL_STORAGE_PATH=./output/pm-docs

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=100

# ─── Azure App Insights (production monitoring) ───────────────────────────────
# Get from: Azure Portal → Application Insights → Connection String
APPLICATIONINSIGHTS_CONNECTION_STRING=

# ─── Dev API Key ─────────────────────────────────────────────────────────────
# Used when AZURE_AD_TENANT_ID is blank (dev mode only — NOT used in production)
DEV_API_KEY=dev-secret-key-change-in-prod
