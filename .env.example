# ─── Application ─────────────────────────────────────────────────────────────
# APP_ENV: development | production
APP_ENV=development
# Generate a strong 32+ char secret: python -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET_KEY=change-me-in-production-use-a-32-char-random-string
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false

# ─── CORS (Production) ───────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Leave blank to use default Azure URL.
# Example: https://pm-automation.azurewebsites.net,https://pm.yourcompany.com
ALLOWED_ORIGINS=

# ─── Azure AD Authentication ─────────────────────────────────────────────────
# Leave ALL blank to run in dev mode (API key only — no real SSO)
# Get these from: Azure Portal → App Registrations → your app
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_AUTHORITY=https://login.microsoftonline.com/

# ─── Database ────────────────────────────────────────────────────────────────
# Leave blank → uses SQLite at data/pm_automation.db (dev)
DATABASE_URL=
# Azure SQL example (production — use Managed Identity):
# DATABASE_URL=mssql+aioodbc:///?odbc_connect=Driver={ODBC Driver 18 for SQL Server};Server=tcp:<server>.database.windows.net,1433;Database=pm_automation;Authentication=ActiveDirectoryMsi;Encrypt=yes;

# ─── Azure Blob Storage ───────────────────────────────────────────────────────
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_CONTAINER_NAME=pm-docs
# Use connection string (dev) OR leave blank and use Managed Identity (prod)
AZURE_STORAGE_CONNECTION_STRING=
# Time-limited SAS URL expiry for download links (hours)
DOWNLOAD_LINK_EXPIRY_HOURS=8

# ─── Azure Key Vault ─────────────────────────────────────────────────────────
# Example: https://pm-keyvault.vault.azure.net/
# Leave blank in dev — all secrets read from this .env file
AZURE_KEY_VAULT_URL=

# ─── FTP / SFTP (internal factory file share) ─────────────────────────────────
FTP_HOST=
FTP_PORT=22
FTP_USERNAME=
FTP_KEY_PATH=
FTP_REMOTE_BASE_PATH=/pm-docs

# ─── AI Provider ─────────────────────────────────────────────────────────────
# Options: openai | watsonx
# watsonx = IBM watsonx.ai (matches Data Flow Diagram exactly)
# openai  = OpenAI GPT-4o (matches Architecture Diagram)
AI_PROVIDER=openai

# ─── OpenAI (use when AI_PROVIDER=openai) ────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL_GENERATION=gpt-4o
OPENAI_MODEL_CLASSIFICATION=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_DIMS=3072

# ─── IBM watsonx.ai (use when AI_PROVIDER=watsonx) ────────────────────────────
# Get from: cloud.ibm.com → Manage → Access (IAM) → API keys
# Data Flow Diagram models:
#   Classification:  ibm/granite-13b-instruct-v2  → detect manufacturer
#   Embedding:       ibm/slate-125m-english-rtrvr → 1024 dims → Azure AI Search
#   Generation:      ibm/granite-3b-code-instruct → extract structured JSON tasks
#   Analytics:       ibm/granite-13b-instruct-v2  → predict next PM due
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
# Override individual model IDs if needed (defaults match Data Flow Diagram):
# WATSONX_MODEL_GENERATION=ibm/granite-3b-code-instruct
# WATSONX_MODEL_CLASSIFICATION=ibm/granite-13b-instruct-v2
# WATSONX_MODEL_ANALYTICS=ibm/granite-13b-instruct-v2
# WATSONX_EMBEDDING_MODEL=ibm/slate-125m-english-rtrvr
# WATSONX_EMBEDDING_DIMS=1024

# ─── Azure AI Search (Vector Store for RAG) ───────────────────────────────────
# Required for RAG pipeline (manual upload feature)
# Get from: Azure Portal → AI Search → Keys
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX_NAME=pm-manuals

# ─── Storage Target ───────────────────────────────────────────────────────────
# Options: local | azure | ftp
DEFAULT_STORAGE_TARGET=local
LOCAL_STORAGE_PATH=./output/pm-docs

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=100

# ─── Azure App Insights (production monitoring) ───────────────────────────────
# Get from: Azure Portal → Application Insights → Connection String
APPLICATIONINSIGHTS_CONNECTION_STRING=

# ─── Dev API Key ─────────────────────────────────────────────────────────────
# Used when AZURE_AD_TENANT_ID is blank (dev mode only — NOT used in production)
DEV_API_KEY=dev-secret-key-change-in-prod
